# rename this file to .env and fill in your token
# get a free token from https://huggingface.co/settings/tokens
HUGGINGFACEHUB_API_TOKEN=

# Any chat-completion-capable model id on the Hugging Face Hub.
# Browse options at:
# https://huggingface.co/models?inference_provider=all&pipeline_tag=text-generation
HF_MODEL_REPO=Qwen/Qwen2.5-7B-Instruct

# Which Inference Provider routes the request (hf-inference, together,
# novita, fireworks-ai, etc.) - not every provider serves every model, so
# change this if you swap HF_MODEL_REPO and get a "model not supported" error.
HF_PROVIDER=hf-inference

# Only set this if you're using your own dedicated Inference Endpoint URL
# instead of the shared Inference Providers router.
# HF_API_BASE=https://your-endpoint.endpoints.huggingface.cloud
